# HCR ActionGuard V5 - local configuration template.
#
# Copy THIS file to `.env` in this directory and fill in the placeholders.
# Copy only the GEMINI_API_KEY *value* across from another project -- never the
# whole .env file. See the PORT note below for why.
# Never commit a real .env. Never put a real key in a Vite/frontend variable:
# everything here is read by the Node server only (server/app.js loads it).
#
# V5 is deliberately separate from V1-V4. It uses its own port, its own demo
# database (data/actionguard-v5.db) and its own browser session keys.

# --- Required for a voice call -------------------------------------------
# Google Gemini API key. Server-side only.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Optional overrides ---------------------------------------------------
# Live native-audio conversation model. Leave unset to use the built-in default.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Backend port. THIS ONE MATTERS.
#
# Do NOT copy V4's .env wholesale to bring the key across: that file contains
# PORT=4175, which is V4's port. If V5 binds 4175 then vite.config.js still
# proxies /api to 4176, nothing is listening there, and the whole browser app
# fails with no visible explanation -- while also blocking V4 from starting.
# The server now refuses to boot on a V1-V4 port rather than let that happen.
#
# Reserved, do not use: 4174 (V1/V2/V3 API), 4175 (V4 API),
#                       5173 (V1/V2/V3 dev), 5174 (V4 dev).
PORT=4176

# --- V5 feature switches (Stage 1-3) -------------------------------------
# Delivery style for the NEXT call: baseline | natural
# `baseline` reproduces V4's prompt byte-for-byte.
VOICE_STYLE=baseline

# How the browser plays the agent's audio: continuous | v4-compatible
#
# Gemini output is documented as 24 kHz. V4 played it into an AudioContext
# running at the hardware rate (48 kHz here), so the browser re-converted every
# chunk on its own and left a click at each chunk join -- a faint repetitive
# tick under the voice, about 4-5 per second.
#
#   continuous     runs the output context at 24 kHz, so nothing is re-converted
#                  per chunk. This is the fix and the default.
#   v4-compatible  reproduces V4 exactly, tick included, for an honest A/B.
AUDIO_PLAYBACK_MODE=continuous

# Prebuilt voice. One of the 30 documented Gemini voices; anything else falls
# back to Kore. Google publishes a one-word descriptor per voice but no gender
# or accent, and these models choose the language themselves — so pick by ear.
# Worth auditioning: Sulafat (Warm), Vindemiatrix (Gentle), Achird (Friendly),
# Achernar (Soft), Schedar (Even), Algieba (Smooth). Kore (Firm) is V4's.
VOICE_NAME=Kore

# Conversation engine for the next call: standard | expressive
#   standard    Gemini 3.1 native audio. The V4 baseline.
#   expressive  Gemini 2.5 native audio with affective dialogue on — Google
#               documents this as the model adapting its style to the tone of
#               the input. 3.1 does NOT support it, so this is a different
#               MODEL, and voice character, latency and turn-taking all change
#               together. Unverified against this agent's tools and
#               interruption path.
VOICE_MODE=standard

# Gate for the expressive engine. While false the server refuses to issue a
# credential for it and downgrades the request to standard, so the UI cannot
# turn it on. Off by default because it is an unproven experiment.
VOICE_EXPRESSIVE_ENABLED=false

# Dedicated live transcription sidecar. Server-authoritative: while this is
# false the token endpoint refuses to issue a transcription credential and the
# UI cannot turn the helper on. Keep false until the recorded-audio screen
# in the V5 build plan (section 12C) has actually passed.
SMART_TRANSCRIPT_ENABLED=false

# Authenticated, on-demand transcript comparison lab (recorded clips only).
# No background API calls; nothing is sent until you press a button.
TRANSCRIPT_LAB_ENABLED=true

# Allow the lab to make real, opt-in calls to the dedicated transcription
# model. While false the lab runs dry: it validates and normalises audio and
# reports what it WOULD send, without contacting the provider.
TRANSCRIPT_LAB_LIVE_CALLS=false

# Dedicated transcription model. Must be present in the server-side allowlist
# in server/transcription/config.js.
# TRANSCRIPT_MODEL=gemini-3.5-transcribe-live

# Write selected clip audio to disk under data/clips/ (opt-in, off by default).
TRANSCRIPT_LAB_STORE_AUDIO=false

# --- Inherited from V4 ----------------------------------------------------
DEMO_EMPLOYEE_EMAIL=employee@prodapt.demo
DEMO_EMPLOYEE_PASSWORD=change-me-locally

# Set to "false" to disable the Call Flight Recorder.
# CALL_FLIGHT_RECORDER=true
