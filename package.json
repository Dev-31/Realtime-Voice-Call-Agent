{
  "name": "hcr-actionguard-v5",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "HCR ActionGuard V5 - V4's interruption-safe voice core plus an independently switchable natural delivery style and a no-authority transcript comparison lab.",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/app.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/app.js",
    "test": "node --test tests/*.test.js",
    "gate:report": "node scripts/gate-report.js",
    "transcript:eval": "node scripts/transcription-eval.js"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "express": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "latest",
    "vite": "latest"
  }
}
